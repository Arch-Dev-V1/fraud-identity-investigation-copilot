# Copy to .env and fill in. agent/env.py loads this file on import, so every
# entry point (app.py, investigate.py, evals/run.py, cache_probe.py) picks it up.
# A variable already exported in your shell always wins over this file.
#
# Format: KEY=VALUE. Comments, blank lines, an optional `export ` prefix and
# surrounding quotes are handled. Multi-line values and ${VAR} interpolation
# are not.
ANTHROPIC_API_KEY=sk-ant-...

# Optional:
# DEMO_MODE=1                 # force demo mode (no model calls, no cost)
# TOOL_TRANSPORT=direct       # skip MCP and the gateway; in-process lookups
# WEB_SEARCH_MAX_USES=2       # web search bills $10 per 1,000 searches
# PROVIDER_API_URL=http://127.0.0.1:8000
# PROVIDER_API_TRACE=body     # log each gateway response body
